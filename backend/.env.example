# ═══════════════════════════════════════════════════════════════════
# HelpingHands Backend — environment variables
# Copy to .env and fill in. NEVER commit the real .env.
# Spring Boot reads these via ${VAR} placeholders in application.yml.
# (Use an .env loader, your IDE run config, or `export`/`set` before mvn.)
# ═══════════════════════════════════════════════════════════════════

# ── Server ──
SERVER_PORT=8080

# ── MySQL ──
DB_URL=jdbc:mysql://localhost:3306/helpinghands?useSSL=false&serverTimezone=UTC&tinyInt1isBit=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Hibernate DDL mode: none | validate | update  (default none — schema is source of truth)
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false

# ── JWT ── (generate: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_BASE64_32_BYTES_MINIMUM
JWT_EXPIRATION=1800000

# ── CORS (comma-separated frontend origins) ──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File storage (accident images) ──
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080/uploads
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=6MB

# ── YOLO AI microservice ──
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_ENABLED=true

# ── Firebase Cloud Messaging (optional; app runs without it) ──
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n for newlines, or point to a service-account file loader.
FIREBASE_PRIVATE_KEY=

# ── Dispatch ──
DISPATCH_MAX_RADIUS_KM=0

LOG_LEVEL=INFO
